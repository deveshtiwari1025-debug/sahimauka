                  <div class="card-body p-0">
                    <div class="text-center"><a href="#" title="MoTA-Profile" onclick="return ExternalWebsiteLink();" target="_blank"> <img src="images/minister_JO.png" class="img-fluid" alt="Card image cap" style="border-top-left-radius: 1rem !important; border-top-right-radius: 1rem !important;"> </a> </div>
                <div class="p-2">
                    <h5 class="card-title text-left text-dark mt-0 mb-0" style="font-size: 14px;">श्री जुएल ओराम</h5>
                    <p class="card-text text-left text-dark mb-0">माननीय मंत्री</p>
                    <ul class="social-icons float-left">
                      <li><a aria-label="MoTAf" href="#" target="_blank" onclick="return ExternalWebsiteLink();"><i class="fab fa-facebook"></i></a></li>
