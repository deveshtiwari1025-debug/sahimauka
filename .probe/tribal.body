<!--  Chatbot Function --->
<section>
    <!-- Floating Chatbot Toggle -->
    <!-- Floating Chatbot Toggle -->
    <div class="floating-chat-btn" id="floatingChatBtn">
        <div class="floating-vid-wrapper">
            <video src="images/tribot.mp4" autoplay loop muted playsinline class="floating-bot-vid"></video>
        </div>
        <span class="floating-chat-label">TriBot</span>
    </div>

    <!-- Chatbot Widget Component -->
    <div class="chatbot-panel" id="chatbotPanel">
        <!-- 1. Header -->
        <div class="chat-header">
            <div class="tricolor-bar"></div>
            <div class="chat-identity">
                <div class="avatar-container">
                    <div class="avatar-img-wrapper">
                        <video src="images/tribot.mp4" autoplay loop muted playsinline class="avatar-vid"></video>
                    </div>
                    <span class="status-dot"></span>
                </div>
                <div class="chat-info">
                    <h3 class="chat-name">TriBot</h3>
                    <p class="chat-status-text">Official Assist</p>
                </div>
            </div>
            <div class="chat-actions">
                <select id="languageSelect" title="Select Language">
                    <option value="en">EN</option>
                    <option value="hi">HI</option>
                    <option value="te">TE</option>
                    <option value="ta">TA</option>
                </select>
                <button type="button" class="header-btn" id="expandBtn" title="Expand">
                    <i class="ri-expand-left-right-line"></i>
                </button>
                <button type="button" class="header-btn" id="newChatBtn" title="New Chat" style="display: none;">
                    <i class="ri-refresh-line"></i>
                </button>
                <button type="button" class="header-btn" id="closeChatBtn" title="Close">
                    <i class="ri-subtract-line"></i>
                </button>
            </div>
        </div>

        <!-- 2. Body (Messages) -->
        <div class="chat-body" id="messagesArea">
            <div class="security-notice">
                <i class="ri-shield-check-fill notice-icon"></i>
                <p class="notice-text">Official Government Assistant. Your conversation is secure and private.</p>
            </div>

            <!-- Welcome Card -->
            <div class="welcome-card">
                <p class="welcome-greeting">Namaste! 🙏</p>
                <p class="welcome-text">I am <strong>TriBot</strong>, your official AI assistant for the Ministry of Tribal Affairs. Ask me about schemes, scholarships, eligibility, or any tribal welfare programme.</p>
            </div>

            <div class="suggestions-container" id="quickQueries" style="margin-top: auto;">
                <span class="suggestions-label">SUGGESTED QUERIES</span>
                <div class="suggestions-list">
                    <button type="button" class="suggestion-chip quick-query-btn">What is PM-JANMAN?</button>
                    <button type="button" class="suggestion-chip quick-query-btn">Apply for Scholarship</button>
                    <button type="button" class="suggestion-chip quick-query-btn">FRA Claims Process</button>
                </div>
            </div>
        </div>

        <!-- 3. Input Bar -->
        <div class="chat-input-bar">
            <!-- Typing Indicator -->
            <div class="typing-indicator-bar" id="typingIndicator" style="display: none;">
                <span class="typing-dots">
                    <span>•</span><span>•</span><span>•</span>
                </span>
                <span style="margin-left: 6px;">Tribot is typing...</span>
            </div>

            <div class="input-wrapper">
                <button type="button" class="icon-btn" id="voiceBtn" title="Voice Input">
                    <i class="ri-mic-line"></i>
                </button>
                <input type="text" class="chat-input" id="chatInput" placeholder="Ask about schemes, scholarships...">
                <button type="button" class="send-btn" id="sendMessageBtn" title="Send Message">
                    <i class="ri-send-plane-fill"></i>
                </button>
            </div>

            <div class="security-footer">
                <i class="ri-government-line"></i> Ministry of Tribal Affairs · <i class="ri-sparkling-2-fill"></i> AI Powered
            </div>
        </div>
    </div>
    
    <!-- API Service for Backend Connection -->
    <!-- API Service for Backend Connection -->
</section>

